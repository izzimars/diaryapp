# Test Environment Variables
NODE_ENV=test
TEMPLATE_NODE_ENV=test

# Database (use separate test database)
DATABASE_URL=postgres://username:password@localhost:5432/diary_test

# JWT Configuration
JWT_SECRET=test-jwt-secret-key-for-testing-only
JWT_EXPIRES_IN=24h

# Server Configuration
PORT=3001

# Test Configuration
TEST_OTP=123456

# Logging
LOG_LEVEL=error

# Admin Default (for testing)
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=admin123